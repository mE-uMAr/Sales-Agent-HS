# Copy to .env and fill in. Never commit .env.

# ── application ───────────────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ── LLM ───────────────────────────────────────────────────────────────
# provider: groq | openai | fake   ("fake" needs no key — used by tests)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_SUMMARY_MODEL=llama-3.1-8b-instant
# Used when LLM_MODEL is rate-limited. Quotas are metered per model, so the
# smaller one usually still has headroom. Leave empty to disable.
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_replace_me
# OPENAI_API_KEY=sk-...

# ── embeddings (local ONNX — no API key, no torch) ────────────────────
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./var/app.db

# ── lead capture ──────────────────────────────────────────────────────
# sink: sqlite | http | composite
LEAD_SINK=sqlite
# CRM_WEBHOOK_URL=https://crm.example.com/hooks/leads
# CRM_WEBHOOK_SECRET=replace_me

# ── security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_TOKEN_SECRET=change_me_in_production
ADMIN_API_KEY=change_me_in_production
WIDGET_PUBLIC_KEY=pub_dev
# Comma-separated. Pin to the WordPress origin in production.
# localhost:3000 is the Next.js test harness in ../frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
